{
  "name": "awesome-list",
  "version": "0.0.0",
  "private": true,
  "description": "A free library of every awesome list and everything in them.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build-data": "tsx src/cli.ts",
    "build-site": "tsx src/site/build/cli.ts",
    "serve": "tsx src/site/server.ts",
    "check-summaries": "tsx scripts/check-summaries.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tsx": "4.23.15",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261124.2",
    "@eslint/js": "10.0.1",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.168.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
